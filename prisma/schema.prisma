generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite ne gère pas les enums ni le type Json : les valeurs contraintes sont
// validées côté serveur (voir types/project.ts et types/website.ts).
model Project {
  id              String   @id @default(cuid())
  /// Identifiant Clerk de l'utilisateur propriétaire (null = projet sans propriétaire, invisible)
  ownerId         String?
  name            String   @unique
  description     String   @default("")
  url             String   @default("")
  kind            String   @default("none")
  status          String   @default("building")
  source          String   @default("git")
  repository      String   @default("")
  branch          String   @default("main")
  preset          String   @default("nuxt")
  rootDirectory   String   @default("./")
  installCommand  String   @default("")
  buildCommand    String   @default("")
  outputDirectory String   @default(".")
  fileCount       Int      @default(0)
  deployments     Int      @default(0)
  requests        String   @default("0")
  errorRate       String   @default("0%")
  /// Valeurs du sparkline séparées par des virgules
  sparkline       String   @default("")
  /// Octets des fichiers uploadés (0 pour un dépôt Git)
  sourceBytes     Int      @default(0)
  /// Octets du dernier site publié (dossier de sortie)
  outputBytes     Int      @default(0)
  /// Date de la dernière capture d'écran du site publié (vide si aucune)
  thumbnailAt     DateTime?
  /// Variables d'environnement du build, en JSON : [{ key, value }]
  envVars         String   @default("[]")
  /// Type de projet : « website » (site statique) ou « webservice » (processus sur un port)
  type            String   @default("website")
  /// Port interne du web service (attribué par Deplay), vide pour un site
  port            Int?
  /// Runtime du web service (clé de config/runtimes.json) : node, python…
  runtime         String   @default("node")
  /// Commande qui démarre le web service, ex. « node server.js »
  startCommand    String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Déploiement d'une application. Les colonnes complexes sont stockées en JSON texte,
// car SQLite ne gère pas le type Json.
model Deployment {
  id           String   @id @default(cuid())
  /// Projet auquel appartient ce déploiement (sans clé étrangère pour rester simple sur SQLite)
  projectId    String?
  name         String
  description  String   @default("")
  type         String   @default("Web Application")
  runtime      String   @default("Node.js")
  environment  String   @default("Production")
  url          String   @default("")
  /// Dossier publié par le worker, pour republier le site après un redémarrage
  buildDir     String   @default("")
  branch       String   @default("main")
  commit       String   @default("")
  status       String   @default("deployed")
  deployedAt   String   @default("")
  duration     String   @default("")
  steps        String   @default("[]")
  logs         String   @default("[]")
  info         String   @default("{}")
  server       String   @default("{}")
  metrics      String   @default("[]")
  /// Configuration de build au moment du déploiement (source, commandes, framework)
  build        String   @default("{}")
  /// Date de prise en charge par le worker : vide tant que le build attend un emplacement
  claimedAt    DateTime?
  /// Jeton GitHub pour cloner un dépôt privé : donné au worker puis effacé dès le début du build
  cloneToken   String?
  createdAt    DateTime @default(now())
}

// Jeton personnel pour la CLI (deplay-cli). Seule l'empreinte SHA-256 est stockée :
// le jeton en clair n'est montré qu'une fois, à la création.
model ApiToken {
  id         String    @id @default(cuid())
  /// Identifiant Clerk du propriétaire
  userId     String
  name       String
  tokenHash  String    @unique
  /// Début du jeton, pour le reconnaître dans la liste (ex. « dpl_a1b2c3 »)
  prefix     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
