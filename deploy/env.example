# Modèle de configuration de Deplay.
# Copier vers /opt/deplay/.env (mode 600, propriétaire deplay) et renseigner les valeurs.
# Ne jamais committer le fichier .env réel.
# Obligatoires : DATABASE_URL, NUXT_PROJECTS_STORAGE_DIR et les deux clés Clerk.
# Le reste a une valeur par défaut : ne le renseigner que pour la changer.

# ============ Application (Nuxt) ============
NODE_ENV=production
# Port et adresse : fixés par deploy/ecosystem.config.cjs (3100 / 127.0.0.1)
# Chemin absolu : la base SQLite est dans /opt/deplay/prisma
DATABASE_URL="file:/opt/deplay/prisma/dev.db"
# Fichiers uploadés (un dossier par projet)
NUXT_PROJECTS_STORAGE_DIR="/opt/deplay/storage/projects"

# ============ Clerk (instance de production, liée à fabrich.site) ============
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=
# Facultatif : page affichée après la déconnexion (la landing, sur un autre domaine que la plateforme)
# NUXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=https://deplay.fabrich.site

# ============ Worker : builds ============
# docker : chaque build dans un conteneur (obligatoire en production)
BUILD_ISOLATION=docker
# Ressources d'UN build ; jusqu'à 3 builds en parallèle (config/limits.json).
# Next.js / Turbopack dépasse 1g : sinon le build est tué (« Killed », code 137).
BUILD_MEMORY=2g
BUILD_CPUS=2
INSTALL_CPUS=2
BUILD_PIDS=512
# Images
BUILD_IMAGE=docker.io/library/node:22-slim
CLONE_IMAGE=docker.io/alpine/git
THUMBNAIL_IMAGE=mcr.microsoft.com/playwright:v1.49.0-jammy
# Dossiers de travail et de cache
DEPLOY_WORK_DIR=/opt/deplay/storage/builds
BUILD_CACHE_DIR=/opt/deplay/storage/cache
THUMBNAILS_DIR=/opt/deplay/storage/thumbnails
# Pour surcharger config/limits.json (sinon laisser commenté)
# MAX_CONCURRENT_BUILDS=3
# MAX_BUILDS_PER_USER=1

# ============ Publication des sites ============
SITE_DOMAIN=fabrich.site
# Dossier servi par nginx (deploy/nginx/deplay-sites.conf)
DEPLOY_SITES_DIR=/www/wwwroot/deplay-sites
# Journaux nginx lus pour les statistiques de trafic
SITE_LOG_DIR=/www/wwwlogs/sites

# ============ Web services ============
SERVICE_ROUTE_SCRIPT=/opt/deplay/deploy/service-route.sh
SERVICE_ROUTES_FILE=/opt/deplay/storage/service-routes.json
# Mémoire et CPU des web services : config/limits.json (1g / 1), pas le .env
PODMAN_BIN=/usr/bin/podman
DEPLAY_HOME=/home/deplay
