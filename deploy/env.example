# Modèle de configuration de Deplay.
# Copier vers /opt/deplay/.env (mode 600, propriétaire deplay) et renseigner les valeurs.
# Ne jamais committer le fichier .env réel.

# --- Application ---
NODE_ENV=production
# Chemin absolu : la base SQLite est dans /opt/deplay/prisma
DATABASE_URL="file:/opt/deplay/prisma/dev.db"
NUXT_PROJECTS_STORAGE_DIR="/opt/deplay/storage/projects"

# --- Clerk (clés de production) ---
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=
# Facultatif : page affichée après la déconnexion (la landing, sur un autre domaine que la plateforme)
# NUXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=https://deplay.fabrich.site

# --- Worker ---
# docker : chaque build dans un conteneur (obligatoire en production)
BUILD_ISOLATION=docker
# Sites statiques publiés dans ce dossier, servis par le bloc nginx deploy/nginx/deplay-sites.conf
SITE_DOMAIN=fabrich.site
DEPLOY_SITES_DIR=/www/wwwroot/deplay-sites
# Ressources d'un build (1 CPU et 1 Go par défaut) et nombre de builds simultanés
# (limites de compte et quota : config/limits.json)
BUILD_CPUS=1
BUILD_MEMORY=1g
