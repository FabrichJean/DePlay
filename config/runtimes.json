{
  "node": {
    "label": "Node.js",
    "image": "docker.io/library/node:22-slim",
    "installCommand": "npm install",
    "startCommand": "node server.js",
    "startPlaceholder": "node server.js"
  },
  "python": {
    "label": "Python",
    "image": "localhost/deplay-python:3.12-ffmpeg",
    "installCommand": "pip install -r requirements.txt",
    "startCommand": "python -m uvicorn main:app --host 0.0.0.0 --port $PORT",
    "startPlaceholder": "python -m uvicorn main:app --host 0.0.0.0 --port $PORT",
    "env": {
      "PYTHONUSERBASE": "/work/.pylocal",
      "PYTHONDONTWRITEBYTECODE": "1"
    }
  }
}
